{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chaiphoto-web",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
